{
  "compilerOptions":{
    "target": "ES2022",
    "module": "nodenext",
    "rootDir": "./src",
    "outDir":"./dist",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true

  },
  "include":[
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude":[
    "node_modules",
    "dist"
  ]
}